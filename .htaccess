# Sa Domu Sarda — configurazione del server (IONOS Hosting Web, Apache)
# Attivare il reindirizzamento HTTPS solo DOPO aver assegnato il certificato SSL al dominio nel pannello IONOS.

Options -Indexes
AddDefaultCharset UTF-8
AddType video/mp4 .mp4

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) sempre HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2) www.dominio -> dominio (un solo indirizzo, meglio per Google)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # 3) blocca file nascosti e di servizio (tranne .well-known, usata per i certificati SSL)
  RewriteRule (^|/)\.(?!well-known/) - [F]
  RewriteRule \.(md|py|zip|bak|log|ini|sh)$ - [F,NC]
</IfModule>

<IfModule mod_headers.c>
  # stessa policy del <meta> in index.html, più le direttive che funzionano solo come header
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' https://static.tacdn.com; media-src 'self'; frame-src https://www.openstreetmap.org; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header unset X-Powered-By
</IfModule>

<IfModule mod_expires.c>
  # cache: foto e video a lungo, CSS/JS 1 giorno, pagina sempre aggiornata
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
